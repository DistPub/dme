{
  "name": "dme-miniapp",
  "version": "0.0.1",
  "private": true,
  "description": "DME (Decentralized Message Envelope) 微信小程序端",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "typecheck": "tsc --noEmit",
    "mp:init": "node scripts/deploy.mjs init",
    "mp:build": "node scripts/deploy.mjs build",
    "mp:upload": "node scripts/deploy.mjs upload"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-mls": "1.6.2",
    "weapp-qrcode-canvas-2d": "^1.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
    "miniprogram-ci": "^2.1.31",
    "sass": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "webpack": "5.91.0"
  },
  "overrides": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@hpke/core": "1.9.0"
  }
}
