{
  "expo": {
    "name": "DME",
    "slug": "dme",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "dme",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dme.client"
    },
    "android": {
      "package": "com.dme.client"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-image-picker"
    ]
  }
}
